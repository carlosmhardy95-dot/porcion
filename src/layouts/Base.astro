---
import '../styles/global.css';
import Logotipo from '../components/Logotipo.astro';
import { SITE_NAME, INDEXABLE } from '../config.js';

const {
  title,
  description,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const robots = INDEXABLE && !noindex ? 'index, follow' : 'noindex, follow';
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const ruta = Astro.url.pathname;
---
<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta name="robots" content={robots}>
  <meta name="theme-color" content="#F4F0E8">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="apple-touch-icon" href="/iconos/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-title" content="Porción">
  <script is:inline>
    // Guarda el aviso de "instalar app" del navegador para mostrar nuestro propio botón.
    window.addEventListener('beforeinstallprompt', function (e) {
      e.preventDefault();
      window.porcionInstalar = e;
      window.dispatchEvent(new Event('porcion-instalable'));
    });
  </script>
  <link rel="sitemap" href="/sitemap-index.xml">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content={SITE_NAME}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:locale" content="es_AR">

  <link rel="preload" href="/fuentes/chivo.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fuentes/rosario.woff2" as="font" type="font/woff2" crossorigin>
  <slot name="head" />
</head>
<body>
  <a class="solo-lectores" href="#contenido">Ir al contenido</a>
  <header class="encabezado">
    <div class="contenedor encabezado-fila">
      <a href="/" class="encabezado-marca" aria-label="Porción, ir al inicio">
        <Logotipo alto={24} etiqueta="Porción" />
      </a>
      <nav aria-label="Principal">
        <a href="/calculadora/" class="encabezado-enlace" aria-current={ruta.startsWith('/calculadora') ? 'page' : undefined}>Calculadora</a>
      </nav>
    </div>
  </header>

  <main id="contenido">
    <slot />
  </main>

  <footer class="pie">
    <div class="contenedor pie-grilla">
      <div class="pie-marca">
        <Logotipo alto={30} etiqueta="Porción" />
        <p class="pie-frase">Calculá mejor. Ganá con claridad.</p>
      </div>
      <div class="pie-columnas">
        <nav class="pie-enlaces" aria-labelledby="pie-guias">
          <p id="pie-guias" class="pie-titulo">Guías</p>
          <a href="/cuanto-cobrar/">Cuánto cobrar</a>
          <a href="/cuanto-cobrar/torta/">Precio de una torta</a>
          <a href="/cuanto-cobrar/docena-de-alfajores/">Docena de alfajores</a>
          <a href="/como-calcular-el-costo-de-una-receta/">Costo de una receta</a>
          <a href="/planilla-de-costos/">Planilla gratis</a>
        </nav>
        <nav class="pie-enlaces" aria-labelledby="pie-porcion">
          <p id="pie-porcion" class="pie-titulo">Porción</p>
          <a href="/calculadora/">Calculadora</a>
          <a href="/metodologia/">Metodología</a>
          <a href="/sobre/">Sobre Porción</a>
          <a href="/privacidad/">Privacidad</a>
        </nav>
      </div>
      <p class="pie-nota">Herramienta gratuita para emprendedores gastronómicos. Sin registro: tus datos quedan en tu dispositivo.</p>
    </div>
  </footer>
  <script>
    // Registra el service worker (solo en el sitio publicado) para que funcione sin internet.
    if (import.meta.env.PROD && 'serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
  </script>
</body>
</html>

<style>
  .encabezado { background: var(--hueso); }
  .encabezado-fila { display: flex; align-items: center; justify-content: space-between; min-height: 72px; }
  .encabezado-marca { display: inline-flex; color: var(--carbon); padding: 8px 0; }
  .encabezado-marca:hover { color: var(--carbon); }
  .encabezado-enlace {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: var(--radio);
    font: 700 0.95rem var(--texto);
    text-decoration: none;
  }
  .encabezado-enlace:hover { background: var(--piedra-clara); color: var(--carbon); }
  .encabezado-enlace[aria-current='page'] { background: var(--carbon); color: var(--hueso); }

  main { min-height: 60vh; }

  main { padding-bottom: 112px; }
  .pie { background: var(--piedra); color: var(--carbon); }
  .pie-grilla { display: grid; gap: 24px; padding-top: 48px; padding-bottom: 40px; }
  .pie-marca { display: flex; flex-direction: column; gap: 14px; color: var(--carbon); }
  .pie-frase { font: 800 1.15rem/1.3 var(--titulo); letter-spacing: -0.01em; }
  .pie-columnas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .pie-enlaces { display: flex; flex-direction: column; align-items: flex-start; }
  .pie-titulo { font: 800 0.95rem var(--titulo); margin-bottom: 4px; }
  .pie-enlaces a { display: inline-flex; align-items: center; min-height: 40px; font-weight: 600; }
  .pie-nota { font-size: 0.88rem; color: var(--carbon-suave); max-width: 36em; }

  @media (min-width: 768px) {
    .pie-grilla { grid-template-columns: 1fr auto; align-items: start; }
    .pie-columnas { gap: 64px; }
    .pie-nota { grid-column: 1 / -1; }
  }
</style>
