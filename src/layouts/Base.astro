---
import '../styles/global.css';
import Logotipo from '../components/Logotipo.astro';
import { SITE_NAME, INDEXABLE } from '../config.js';

const {
  title,
  description,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const robots = INDEXABLE && !noindex ? 'index, follow' : 'noindex, follow';
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const ruta = Astro.url.pathname;
---
<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta name="robots" content={robots}>
  <meta name="theme-color" content="#F3EBDD">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="apple-touch-icon" href="/iconos/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-title" content="Porción">
  <script is:inline>
    // Guarda el aviso de "instalar app" del navegador para mostrar nuestro propio botón.
    window.addEventListener('beforeinstallprompt', function (e) {
      e.preventDefault();
      window.porcionInstalar = e;
      window.dispatchEvent(new Event('porcion-instalable'));
    });
  </script>
  <link rel="sitemap" href="/sitemap-index.xml">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content={SITE_NAME}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:locale" content="es_AR">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400..700&family=Fraunces:opsz,wght@9..144,500..700&display=swap">
  <slot name="head" />
</head>
<body>
  <a class="solo-lectores" href="#contenido">Ir al contenido</a>
  <header class="encabezado">
    <div class="contenedor encabezado-fila">
      <a href="/" class="encabezado-marca" aria-label="porción, ir al inicio">
        <Logotipo alto={30} etiqueta="porción" />
      </a>
      <nav aria-label="Principal">
        <a href="/calculadora/" class="encabezado-enlace" aria-current={ruta.startsWith('/calculadora') ? 'page' : undefined}>Calculadora</a>
      </nav>
    </div>
  </header>

  <main id="contenido">
    <slot />
  </main>

  <footer class="pie">
    <div class="contenedor pie-grilla">
      <div class="pie-marca">
        <Logotipo alto={40} etiqueta="porción" />
        <p class="pie-frase">Calculá mejor. Ganá con claridad.</p>
      </div>
      <nav class="pie-enlaces" aria-label="Pie de página">
        <a href="/calculadora/">Calculadora</a>
        <a href="/calculadora/?ejemplo=alfajores">Ver un ejemplo</a>
      </nav>
      <p class="pie-nota">Herramienta gratuita para emprendedores gastronómicos. Sin registro: tus datos quedan en tu dispositivo.</p>
    </div>
  </footer>
  <script>
    // Registra el service worker (solo en el sitio publicado) para que funcione sin internet.
    if (import.meta.env.PROD && 'serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
  </script>
</body>
</html>

<style>
  .encabezado { border-bottom: 1px solid var(--masa); background: var(--harina); }
  .encabezado-fila { display: flex; align-items: center; justify-content: space-between; min-height: 68px; }
  .encabezado-marca { display: inline-flex; color: var(--tinta); padding: 6px 0; }
  .encabezado-marca:hover { color: var(--tinta); }
  .encabezado-enlace {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font: 500 0.95rem var(--sans);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .encabezado-enlace:hover,
  .encabezado-enlace[aria-current='page'] { border-bottom-color: var(--guinda); color: var(--tinta); }

  main { min-height: 60vh; }

  .pie { margin-top: 96px; background: var(--tinta); color: var(--harina); --logo-acento: var(--yema); }
  .pie-grilla { display: grid; gap: 28px; padding-top: 48px; padding-bottom: 48px; }
  .pie-marca { display: flex; flex-direction: column; gap: 14px; }
  .pie-frase { font: 500 1.25rem/1.3 var(--serif); font-variation-settings: 'opsz' 48; }
  .pie-enlaces { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .pie-enlaces a { color: var(--harina); display: inline-flex; align-items: center; min-height: 44px; }
  .pie-enlaces a:hover { color: var(--yema); }
  .pie-nota { font-size: 0.85rem; color: var(--masa); max-width: 34em; padding-top: 20px; border-top: 1px solid rgba(243, 235, 221, 0.18); }
  .pie :focus-visible { outline-color: var(--yema); }

  @media (min-width: 768px) {
    .pie-grilla { grid-template-columns: 1fr auto; align-items: start; }
    .pie-nota { grid-column: 1 / -1; }
  }
</style>
