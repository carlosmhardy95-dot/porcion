---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada" description="No encontramos esta página." noindex>
  <section class="contenedor no-encontrada">
    <p class="cifra numero-error" aria-hidden="true">404</p>
    <p class="anotacion"><span>!</span>Página no encontrada</p>
    <h1>Esta página no está en la receta.</h1>
    <p>Puede que el enlace esté mal escrito o que la página ya no exista.</p>
    <div class="acciones">
      <a class="boton" href="/calculadora/">Ir a la calculadora</a>
      <a class="boton-secundario" href="/">Volver al inicio</a>
    </div>
  </section>
</Base>

<style>
  .no-encontrada { display: flex; flex-direction: column; gap: 18px; padding-top: 56px; }
  .no-encontrada > * { max-width: 640px; }
  .numero-error { font-size: clamp(5rem, 22vw, 9rem); line-height: 0.9; color: var(--guinda); }
  .no-encontrada h1 { font-size: clamp(2rem, 6vw, 3.2rem); }
  .acciones { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
</style>
