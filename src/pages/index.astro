---
import Base from '../layouts/Base.astro';
import { estadoInicial } from '../lib/almacen.js';
import { crearDesdePlantilla } from '../lib/plantillas.js';
import { calcularReceta, dinero, num } from '../lib/calculo.js';

// Los números de la portada salen de la calculadora real (ejemplo de alfajores),
// así nunca muestran algo distinto de lo que calcula la herramienta.
const { estado, recetaId } = crearDesdePlantilla('alfajores', estadoInicial());
const receta = estado.recetas.find((r) => r.id === recetaId);
const insumos = Object.fromEntries(estado.insumos.map((i) => [i.id, i]));
const r = calcularReceta(receta, insumos, estado.negocio);
const impuestos = r.precio * (num(receta.impuestos) / 100);
const margen = (Math.round((r.ganancia / r.precio) * 1000) / 10).toLocaleString('es-AR');

// Cada tramo con su color: costos en grises de carbón y piedra, ingredientes en pimentón,
// ganancia en oliva (el único positivo).
const COLORES = {
  tiempo: 'var(--carbon)',
  ingredientes: 'var(--pimenton)',
  fijos: 'var(--carbon-suave)',
  caja: 'var(--borde)',
  gas: 'var(--piedra)',
};
const tramos = [
  ...r.partes.map((p) => ({ clave: p.clave, etiqueta: p.etiqueta, valor: p.valor, color: COLORES[p.clave] })),
  { clave: 'impuestos', etiqueta: 'Impuestos y comisiones', valor: impuestos, color: 'var(--piedra-clara)' },
  { clave: 'ganancia', etiqueta: 'Tu ganancia', valor: r.ganancia, color: 'var(--oliva)' },
];
const ancho = (v) => `${((v / r.precio) * 100).toFixed(2)}%`;
---
<Base
  title="Porción: calculá el costo y el precio de tus recetas"
  description="Calculadora gratis para emprendedores gastronómicos. Calculá cuánto te cuesta producir, definí tus precios de venta y descubrí cuánto ganás. Sin registro."
>
  <section class="contenedor portada">
    <div class="portada-texto">
      <h1>Que tus números cierren tan bien como tus recetas.</h1>
      <p class="bajada">Calculá cuánto te cuesta producir, definí tus precios de venta y descubrí cuánto ganás realmente. Gratis y sin complicaciones.</p>
      <div class="acciones">
        <a class="boton" href="/calculadora/">Calcular mis costos</a>
        <a class="enlace-ejemplo" href="/calculadora/?ejemplo=alfajores">Ver un ejemplo</a>
      </div>
    </div>

    <figure class="resultado" aria-labelledby="resultado-pie">
      <p class="resultado-etiqueta">Precio de venta sugerido</p>
      <p class="resultado-precio cifra">{dinero(r.precio)}</p>
      <dl class="resultado-cifras">
        <div><dt>Costo por unidad</dt><dd class="cifra">{dinero(r.C)}</dd></div>
        <div><dt>Costo de la tanda</dt><dd class="cifra">{dinero(r.C * r.R)}</dd></div>
        <div><dt>Ganancia real</dt><dd class="cifra positivo">{dinero(r.ganancia)}</dd></div>
        <div><dt>Margen</dt><dd class="cifra">{margen} %</dd></div>
      </dl>
      <figcaption id="resultado-pie">Ejemplo: {receta.nombre.toLowerCase()}, tanda de {r.R}, con precios de muestra.</figcaption>
    </figure>
  </section>

  <section class="contenedor reparto" aria-labelledby="reparto-titulo">
    <h2 id="reparto-titulo">De cada <span class="cifra">{dinero(r.precio)}</span> que cobrás, <span class="cifra ganancia">{dinero(r.ganancia)}</span> son tuyos.</h2>
    <p class="reparto-bajada">El resto paga lo que no siempre se ve: tu tiempo, los ingredientes, los gastos fijos, la caja, el gas y los impuestos. <a href="/cuanto-cobrar/">Cómo se calcula el precio</a></p>
    <div class="barra" aria-hidden="true">
      {tramos.map((t) => <span style={`width:${ancho(t.valor)};background:${t.color}`}></span>)}
    </div>
    <ul class="leyenda">
      {tramos.map((t) => (
        <li class={t.clave === 'ganancia' ? 'es-ganancia' : ''}>
          <span class="muestra" style={`background:${t.color}`} aria-hidden="true"></span>
          <span>{t.etiqueta}</span>
          <span class="cifra">{dinero(t.valor)}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="contenedor pasos" aria-labelledby="pasos-titulo">
    <h2 id="pasos-titulo">Tres pasos. Sin planillas.</h2>
    <div class="pasos-grilla">
      <article>
        <h3>Cargá tus ingredientes</h3>
        <p>Lo que pagás por cada paquete y cuánto usás. Porción hace la cuenta por vos.</p>
      </article>
      <article>
        <h3>Sumá lo que no se ve</h3>
        <p>El gas y la luz, tu tiempo de trabajo, la caja y los gastos fijos del mes.</p>
      </article>
      <article>
        <h3>Mirá tu número</h3>
        <p>Costo por unidad, precio sugerido y cuánto ganás de verdad en cada venta.</p>
      </article>
    </div>
  </section>

  <section class="contenedor incluye" aria-labelledby="incluye-titulo">
    <h2 id="incluye-titulo">Hecha para tu cocina.</h2>
    <dl class="incluye-lista">
      <div><dt>Despensa compartida</dt><dd>Cargás un ingrediente una vez y lo usás en todas tus recetas. Si sube, se actualizan todas.</dd></div>
      <div><dt>Lista de precios</dt><dd>Una imagen para historias y el texto para WhatsApp, armados con tus productos.</dd></div>
      <div><dt>Funciona sin internet</dt><dd>Instalala en el celular como una app.</dd></div>
      <div><dt>Tus datos son tuyos</dt><dd>Sin registro. Todo queda en tu dispositivo y podés descargar una copia.</dd></div>
    </dl>
  </section>

  <section class="cierre" aria-labelledby="cierre-titulo">
    <div class="contenedor cierre-fila">
      <h2 id="cierre-titulo">Cada receta tiene su número.</h2>
      <div class="cierre-accion">
        <a class="boton" href="/calculadora/">Calcular mis costos</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .portada { display: grid; gap: 40px; padding-top: 40px; }
  .portada-texto { display: flex; flex-direction: column; gap: 22px; }
  .portada h1 { max-width: 11em; }
  .bajada { font-size: 1.15rem; max-width: 30em; color: var(--carbon-suave); }
  .acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 6px; }
  .enlace-ejemplo { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; }

  /* Bloque de resultado: el número manda */
  .resultado { margin: 0; padding: 24px; background: var(--carbon); color: var(--hueso); border-radius: var(--radio); display: flex; flex-direction: column; }
  .resultado-etiqueta { font-weight: 600; color: var(--piedra); }
  .resultado-precio { font-size: clamp(4rem, 19vw, 6rem); font-weight: 900; line-height: 1; letter-spacing: -0.045em; margin: 4px 0 20px; }
  .resultado-cifras { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .resultado-cifras div { padding: 12px 14px; background: rgba(244, 240, 232, 0.08); border-radius: 2px; }
  .resultado-cifras dt { font-size: 0.88rem; color: var(--piedra); }
  .resultado-cifras dd { margin: 2px 0 0; font-size: 1.45rem; font-weight: 800; }
  .positivo { color: var(--oliva-luz); }
  .resultado figcaption { margin-top: 16px; font-size: 0.85rem; color: var(--piedra); }

  /* Reparto del precio: la barra se divide con cortes, como el calado del logo */
  .reparto { display: flex; flex-direction: column; gap: 18px; padding-top: 96px; }
  .reparto h2 { max-width: 15em; }
  .reparto h2 .cifra { font-weight: 900; }
  .ganancia { color: var(--oliva-oscuro); }
  .reparto-bajada { color: var(--carbon-suave); max-width: 34em; }
  .barra { display: flex; gap: 4px; height: 44px; margin-top: 10px; }
  .barra span { display: block; min-width: 4px; border-radius: 2px; }
  .leyenda { list-style: none; margin: 4px 0 0; padding: 0; display: grid; column-gap: 40px; row-gap: 2px; }
  .leyenda li { display: grid; grid-template-columns: 14px 1fr auto; align-items: center; gap: 12px; padding: 8px 0; }
  .leyenda .cifra { font-weight: 700; font-size: 1.05rem; }
  .muestra { width: 14px; height: 14px; border-radius: 2px; box-shadow: inset 0 0 0 1px rgba(41, 38, 41, 0.18); }
  .es-ganancia { font-weight: 700; color: var(--oliva-oscuro); }

  /* Pasos y beneficios: bloques separados por cortes */
  .pasos, .incluye { display: flex; flex-direction: column; gap: 24px; padding-top: 96px; }
  .pasos-grilla { display: grid; gap: 6px; }
  .pasos-grilla article { padding: 24px; background: var(--piedra-clara); border-radius: var(--radio); display: flex; flex-direction: column; gap: 8px; }
  .pasos-grilla p { color: var(--carbon-suave); }
  .incluye-lista { margin: 0; display: grid; gap: 22px 40px; }
  .incluye-lista dt { font: 800 1.1rem/1.25 var(--titulo); letter-spacing: -0.01em; margin-bottom: 4px; }
  .incluye-lista dd { margin: 0; color: var(--carbon-suave); max-width: 30em; }

  /* Cierre */
  .cierre { margin-top: 112px; margin-bottom: -112px; background: var(--carbon); color: var(--hueso); }
  .cierre-fila { display: flex; flex-direction: column; gap: 28px; padding-top: 64px; padding-bottom: 64px; }
  .cierre h2 { font-size: clamp(2.4rem, 8vw, 4.2rem); max-width: 9em; }
  .cierre-accion { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .cierre-accion p { color: var(--piedra); font-size: 1.1rem; }
  .cierre :focus-visible { outline-color: var(--hueso); }

  @media (min-width: 900px) {
    .portada { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); align-items: center; gap: 56px; padding-top: 80px; }
    .resultado { padding: 28px; }
    .reparto { padding-top: 128px; }
    .leyenda { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pasos-grilla { grid-template-columns: repeat(3, 1fr); }
    .incluye-lista { grid-template-columns: repeat(2, 1fr); }
    .cierre-fila { flex-direction: row; align-items: flex-end; justify-content: space-between; padding-top: 88px; padding-bottom: 88px; }
    .cierre-accion { align-items: flex-end; text-align: right; }
  }
</style>
