---
import Base from '../layouts/Base.astro';
import { estadoInicial } from '../lib/almacen.js';
import { crearDesdePlantilla } from '../lib/plantillas.js';
import { calcularReceta, dinero, num } from '../lib/calculo.js';

// Los números de la portada salen de la calculadora real (ejemplo de alfajores),
// así nunca muestran algo distinto de lo que calcula la herramienta.
const { estado, recetaId } = crearDesdePlantilla('alfajores', estadoInicial());
const receta = estado.recetas.find((r) => r.id === recetaId);
const insumos = Object.fromEntries(estado.insumos.map((i) => [i.id, i]));
const r = calcularReceta(receta, insumos, estado.negocio);
const impuestos = r.precio * (num(receta.impuestos) / 100);
const margen = Math.round((r.ganancia / r.precio) * 100);

const COLORES = {
  ingredientes: 'var(--guinda)',
  tiempo: 'var(--tinta)',
  fijos: 'var(--tinta-suave)',
  caja: 'var(--masa)',
  gas: 'var(--yema)',
};
const tramos = [
  ...r.partes.map((p) => ({ clave: p.clave, etiqueta: p.etiqueta, valor: p.valor, color: COLORES[p.clave] })),
  { clave: 'impuestos', etiqueta: 'Impuestos y comisiones', valor: impuestos, color: 'var(--carta)' },
  { clave: 'ganancia', etiqueta: 'Tu ganancia', valor: r.ganancia, color: 'var(--oliva)' },
];
const porcentaje = (v) => `${((v / r.precio) * 100).toFixed(2)}%`;
---
<Base
  title="Porción: calculá el costo y el precio de tus recetas"
  description="Calculadora gratis para emprendedores gastronómicos. Calculá cuánto te cuesta producir, definí tus precios de venta y descubrí cuánto ganás. Sin registro."
>
  <section class="contenedor portada">
    <div class="portada-texto">
      <p class="anotacion"><span>01</span>Gratis · para gastronomía</p>
      <h1>Que tus números cierren tan bien como tus recetas.</h1>
      <p class="bajada">Calculá cuánto te cuesta producir, definí tus precios de venta y descubrí cuánto ganás realmente. Gratis y sin complicaciones.</p>
      <div class="acciones">
        <a class="boton" href="/calculadora/">
          Calcular mis costos
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a class="enlace-ejemplo" href="/calculadora/?ejemplo=alfajores">Probar con un ejemplo</a>
      </div>
    </div>

    <figure class="ficha" aria-labelledby="ficha-pie">
      <span class="ficha-cuarto" aria-hidden="true"></span>
      <div class="ficha-cabecera">
        <span>Ficha N.º 001</span>
        <span>Rinde {r.R} u.</span>
      </div>
      <p class="ficha-producto">{receta.nombre}</p>
      <dl class="ficha-filas">
        <div><dt>Costo total de producción</dt><dd class="cifra">{dinero(r.C * r.R)}</dd></div>
        <div><dt>Costo por unidad</dt><dd class="cifra">{dinero(r.C)}</dd></div>
      </dl>
      <div class="ficha-precio">
        <span>Precio de venta sugerido</span>
        <strong class="cifra">{dinero(r.precio)}</strong>
      </div>
      <dl class="ficha-filas ficha-final">
        <div><dt>Ganancia real</dt><dd class="cifra positivo">{dinero(r.ganancia)}</dd></div>
        <div><dt>Margen</dt><dd class="cifra">{margen} %</dd></div>
      </dl>
      <figcaption id="ficha-pie">Ejemplo con precios de muestra, por unidad.</figcaption>
    </figure>
  </section>

  <section class="contenedor reparto" aria-labelledby="reparto-titulo">
    <p class="anotacion"><span>02</span>Dónde va cada peso</p>
    <h2 id="reparto-titulo">De cada <span class="cifra">{dinero(r.precio)}</span> que cobrás, <span class="cifra subrayado">{dinero(r.ganancia)}</span> son tuyos.</h2>
    <div class="reparto-barra" aria-hidden="true">
      {tramos.map((t) => (
        <span class={`tramo tramo-${t.clave}`} style={`width:${porcentaje(t.valor)};background:${t.color}`}></span>
      ))}
    </div>
    <ol class="reparto-lista">
      {tramos.map((t) => (
        <li class={t.clave === 'ganancia' ? 'es-ganancia' : ''}>
          <span class={`muestra tramo-${t.clave}`} style={`background:${t.color}`} aria-hidden="true"></span>
          <span class="reparto-etiqueta">{t.etiqueta}</span>
          <span class="cifra">{dinero(t.valor)}</span>
        </li>
      ))}
    </ol>
    <p class="nota">Alfajores de maicena, tanda de {r.R}, con {num(receta.ganancia)} % de ganancia y {num(receta.impuestos)} % de impuestos. Valores de ejemplo.</p>
  </section>

  <section class="contenedor pasos" aria-labelledby="pasos-titulo">
    <p class="anotacion"><span>03</span>Cómo funciona</p>
    <h2 id="pasos-titulo">Tres pasos, sin planillas.</h2>
    <ol class="pasos-lista">
      <li>
        <span class="paso-numero cifra">01</span>
        <h3>Cargá tus ingredientes</h3>
        <p>Lo que pagás por cada paquete y cuánto usás en la receta. Porción hace la cuenta.</p>
      </li>
      <li>
        <span class="paso-numero cifra">02</span>
        <h3>Sumá lo que no se ve</h3>
        <p>El gas y la luz, tu tiempo, la caja y los gastos fijos del mes.</p>
      </li>
      <li>
        <span class="paso-numero cifra">03</span>
        <h3>Mirá tu número</h3>
        <p>Costo por unidad, precio sugerido y cuánto ganás de verdad en cada venta.</p>
      </li>
    </ol>
  </section>

  <section class="contenedor incluye" aria-labelledby="incluye-titulo">
    <p class="anotacion"><span>04</span>Hecha para tu cocina</p>
    <h2 id="incluye-titulo" class="solo-lectores">Qué incluye</h2>
    <ul class="incluye-lista">
      <li><strong>Despensa compartida.</strong> Cargás un ingrediente una vez y lo usás en todas tus recetas. Si sube, se actualizan todas.</li>
      <li><strong>Lista de precios.</strong> Armá una imagen para historias y el texto para WhatsApp con tus productos.</li>
      <li><strong>Funciona sin internet.</strong> Instalala en el celular como una app.</li>
      <li><strong>Tus datos son tuyos.</strong> Sin registro. Todo queda en tu dispositivo y podés descargar una copia.</li>
    </ul>
  </section>

  <section class="frase" aria-labelledby="frase-titulo">
    <div class="contenedor frase-fila">
      <span class="frase-cuarto" aria-hidden="true"></span>
      <h2 id="frase-titulo">Cada receta tiene su número.</h2>
      <a class="boton boton-claro" href="/calculadora/">Calcular mis costos</a>
    </div>
  </section>
</Base>

<style>
  /* Portada */
  .portada { display: grid; gap: 48px; padding-top: 48px; padding-bottom: 24px; }
  .portada-texto { display: flex; flex-direction: column; gap: 24px; }
  .portada h1 { max-width: 11.5em; }
  .bajada { font-size: 1.15rem; max-width: 32em; color: var(--tinta); }
  .acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 4px; }
  .enlace-ejemplo { display: inline-flex; align-items: center; min-height: 44px; font-weight: 500; }

  /* Ficha de costos: anotación de cocina + números protagonistas */
  .ficha {
    position: relative;
    margin: 0;
    padding: 24px 22px 20px;
    background: var(--carta);
    border: 1px solid var(--tinta);
    border-radius: var(--radio);
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow: hidden;
  }
  .ficha-cuarto { position: absolute; top: 0; right: 0; width: 64px; height: 64px; background: var(--guinda); border-bottom-left-radius: 100%; }
  .ficha-cabecera {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-right: 64px;
    padding-bottom: 12px;
    border-bottom: 1px dashed var(--borde);
    font: 500 0.7rem/1.3 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }
  .ficha-producto { font: 600 1.6rem/1.1 var(--serif); font-variation-settings: 'opsz' 72; letter-spacing: -0.01em; }
  .ficha-filas { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .ficha-filas div { display: flex; align-items: baseline; gap: 8px; }
  .ficha-filas dt { font-size: 0.95rem; color: var(--tinta-suave); }
  .ficha-filas div::after { content: ''; order: 1; flex: 1; border-bottom: 1px dotted var(--borde); transform: translateY(-4px); }
  .ficha-filas dd { order: 2; margin: 0; font-size: 1.05rem; }
  .ficha-precio {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 16px 0;
    border-top: 1px solid var(--tinta);
    border-bottom: 1px solid var(--tinta);
  }
  .ficha-precio span { font: 500 0.75rem var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--guinda); }
  .ficha-precio strong { font-size: clamp(3rem, 13vw, 4.4rem); font-weight: 500; line-height: 1; letter-spacing: -0.04em; }
  .positivo { color: var(--oliva-oscuro); }
  .ficha figcaption { font-size: 0.8rem; color: var(--tinta-suave); }

  /* Reparto del precio: porciones geométricas */
  .reparto { display: flex; flex-direction: column; gap: 20px; padding-top: 72px; }
  .reparto h2 { max-width: 16em; }
  .subrayado { box-shadow: inset 0 -0.18em 0 var(--yema-claro); }
  .reparto-barra { display: flex; height: 56px; border: 1px solid var(--tinta); border-radius: var(--radio); overflow: hidden; }
  .tramo { display: block; height: 100%; border-right: 1px solid var(--tinta); }
  .tramo:last-child { border-right: 0; }
  .reparto-lista { list-style: none; margin: 0; padding: 0; display: grid; column-gap: 48px; }
  .reparto h2 .cifra { font-size: 0.9em; font-weight: 500; letter-spacing: -0.03em; }
  .reparto-lista li { display: grid; grid-template-columns: 14px 1fr auto; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--masa); }
  .reparto-lista .cifra { font-size: 1.05rem; }
  .muestra { width: 14px; height: 14px; border: 1px solid var(--tinta); border-top-right-radius: 100%; }
  .es-ganancia { font-weight: 600; }
  .es-ganancia .cifra { color: var(--oliva-oscuro); }
  .nota { font-size: 0.85rem; color: var(--tinta-suave); }

  /* Pasos */
  .pasos { display: flex; flex-direction: column; gap: 20px; padding-top: 80px; }
  .pasos-lista { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--tinta); }
  .pasos-lista li { display: grid; grid-template-columns: 56px 1fr; column-gap: 12px; row-gap: 6px; padding: 22px 0; border-bottom: 1px solid var(--masa); }
  .paso-numero { grid-row: span 2; font-size: 1.6rem; color: var(--guinda); line-height: 1.1; }
  .pasos-lista p { color: var(--tinta-suave); max-width: 28em; }

  /* Incluye */
  .incluye { display: flex; flex-direction: column; gap: 20px; padding-top: 80px; }
  .incluye-lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: var(--masa); border: 1px solid var(--masa); }
  .incluye-lista li { background: var(--harina); padding: 20px; color: var(--tinta-suave); }
  .incluye-lista strong { display: block; color: var(--tinta); font: 600 1.15rem/1.2 var(--serif); font-variation-settings: 'opsz' 48; margin-bottom: 6px; }

  /* Frase */
  .frase { margin-top: 96px; background: var(--guinda); color: var(--harina); overflow: hidden; }
  .frase-fila { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 28px; padding-top: 64px; padding-bottom: 64px; }
  .frase h2 { font-size: clamp(2.2rem, 7vw, 4rem); max-width: 10em; }
  .frase-cuarto { position: absolute; right: -40px; bottom: -40px; width: 180px; height: 180px; background: var(--yema); border-top-left-radius: 100%; opacity: 0.9; }
  .boton-claro { background: var(--harina); color: var(--tinta); position: relative; }
  .boton-claro:hover { background: var(--tinta); color: var(--harina); }
  .frase :focus-visible { outline-color: var(--harina); }

  @media (min-width: 900px) {
    .portada { grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr); align-items: center; gap: 64px; padding-top: 88px; }
    .ficha { padding: 28px 28px 22px; }
    .reparto { padding-top: 112px; }
    .reparto-lista { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pasos-lista { grid-template-columns: repeat(3, 1fr); border-top: 0; }
    .pasos-lista li { grid-template-columns: 1fr; border-top: 1px solid var(--tinta); border-bottom: 0; padding-right: 24px; }
    .paso-numero { grid-row: auto; font-size: 2.6rem; margin-bottom: 8px; }
    .incluye-lista { grid-template-columns: repeat(2, 1fr); }
    .frase-fila { flex-direction: row; align-items: center; justify-content: space-between; padding-top: 88px; padding-bottom: 88px; }
    .frase-cuarto { width: 260px; height: 260px; right: -60px; bottom: -60px; }
  }
</style>
